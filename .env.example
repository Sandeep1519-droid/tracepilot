PORT=4310
DEMO_PORT=4311
DATA_DIR=./data
# Exact origins only. The bundled demo origin is automatically included.
ALLOWED_ORIGINS=
# Free local AI (install Ollama and download a suitable model first):
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen3:4b
# Optional OpenAI-compatible hosted provider; no key required for scripted mode.
# MODEL_PROVIDER=openai
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=your-model
# OPENAI_API_KEY=
# Optional external test account, never sent to the model:
# TEST_ACCOUNT_EMAIL=
# TEST_ACCOUNT_PASSWORD=
# Optional cost per million tokens; unknown if omitted:
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=
